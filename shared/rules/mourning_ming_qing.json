{
  "ruleset": "ming_qing",
  "version": "1.0",
  "description": "明清定型版服制（《仪礼·丧服》经明洪武损益后之常行制）。条目以设计文档 4.4.3 调研表为准；史料互歧条目（兄弟之妻等）取表中所列一说，待谱学顾问终审。",
  "path_format": "步骤序列：F=父 M=母 S=子 D=女 H=夫 W=妻 B+/B-=兄/弟 Z+/Z-=姊/妹；'+'/'-' 表示该步相对参照节点（路径中前一节点，或末端节点的同代主干节点）为长/幼；'.' 连接。",
  "grades": [
    {"id": "zhancui",        "name": "斩衰",       "period": "三年",   "months": 27},
    {"id": "qicui_zhang",    "name": "齐衰杖期",   "period": "一年",   "months": 13},
    {"id": "qicui_buzhang",  "name": "齐衰不杖期", "period": "一年",   "months": 13},
    {"id": "qicui_wuyue",    "name": "齐衰五月",   "period": "五月",   "months": 5},
    {"id": "qicui_sanyue",   "name": "齐衰三月",   "period": "三月",   "months": 3},
    {"id": "dagong",         "name": "大功",       "period": "九月",   "months": 9},
    {"id": "xiaogong",       "name": "小功",       "period": "五月",   "months": 5},
    {"id": "sima",           "name": "缌麻",       "period": "三月",   "months": 3},
    {"id": "tanmian",        "name": "袒免",       "period": "无服期", "months": 0},
    {"id": "wufu",           "name": "无服",       "period": "无",     "months": 0}
  ],
  "rules": [
    {"path": "F",             "grade": "zhancui",       "basis": "子为父（斩衰三年）"},
    {"path": "F",             "grade": "qicui_buzhang", "when": {"ego_gender": "female", "ego_married": true}, "basis": "已嫁女为父母（降为期亲）"},
    {"path": "M",             "grade": "zhancui",       "basis": "明清子为母（父母同科）"},
    {"path": "M",             "grade": "qicui_buzhang", "when": {"ego_gender": "female", "ego_married": true}, "basis": "已嫁女为父母（降为期亲）"},
    {"path": "F.F",           "grade": "qicui_buzhang", "basis": "为祖父母（齐衰不杖期）"},
    {"path": "F.F",           "grade": "zhancui",       "when": {"ego_is_heir": true}, "basis": "承重孙为祖父（斩衰三年）"},
    {"path": "F.M",           "grade": "qicui_buzhang", "basis": "为祖母（齐衰不杖期）"},
    {"path": "M.F",           "grade": "xiaogong",      "basis": "外亲为外祖父母（小功）"},
    {"path": "M.M",           "grade": "xiaogong",      "basis": "外亲为外祖父母（小功）"},
    {"path": "F.F.F",         "grade": "qicui_wuyue",   "basis": "为曾祖父母（齐衰五月）"},
    {"path": "F.F.M",         "grade": "qicui_wuyue",   "basis": "为曾祖父母（齐衰五月）"},
    {"path": "F.F.F.F",       "grade": "qicui_sanyue",  "basis": "为高祖父母（齐衰三月）"},
    {"path": "F.F.F.M",       "grade": "qicui_sanyue",  "basis": "为高祖父母（齐衰三月）"},

    {"path": "S",             "grade": "qicui_buzhang", "basis": "为众子（齐衰不杖期）"},
    {"path": "S",             "grade": "zhancui",       "when": {"alter_is_heir": true}, "basis": "父为嫡长子（斩衰三年）"},
    {"path": "D",             "grade": "qicui_buzhang", "basis": "为在室女（齐衰不杖期）"},
    {"path": "D",             "grade": "dagong",        "when": {"alter_married": true}, "basis": "为出嫁女（大功）"},
    {"path": "S.S",           "grade": "dagong",        "basis": "为众孙（大功）"},
    {"path": "S.S",           "grade": "zhancui",       "when": {"alter_is_heir": true}, "basis": "为承重孙（斩衰三年）"},
    {"path": "S.D",           "grade": "dagong",        "basis": "为孙女（大功）"},
    {"path": "S.S.S",         "grade": "sima",          "basis": "为曾孙（缌麻）"},
    {"path": "S.S.D",         "grade": "sima",          "basis": "为曾孙女（缌麻）"},
    {"path": "D.S",           "grade": "xiaogong",      "basis": "为外孙（小功）"},
    {"path": "D.D",           "grade": "xiaogong",      "basis": "为外孙女（小功）"},

    {"path": "B+",            "grade": "qicui_buzhang", "basis": "为兄弟（期亲，齐衰不杖期）"},
    {"path": "B-",            "grade": "qicui_buzhang", "basis": "为兄弟（期亲，齐衰不杖期）"},
    {"path": "Z+",            "grade": "qicui_buzhang", "basis": "为在室姊妹（齐衰不杖期）"},
    {"path": "Z+",            "grade": "dagong",        "when": {"alter_married": true}, "basis": "为已嫁姊妹（大功）"},
    {"path": "Z-",            "grade": "qicui_buzhang", "basis": "为在室姊妹（齐衰不杖期）"},
    {"path": "Z-",            "grade": "dagong",        "when": {"alter_married": true}, "basis": "为已嫁姊妹（大功）"},
    {"path": "B+.S",          "grade": "qicui_buzhang", "basis": "为兄弟之子（侄，齐衰不杖期）"},
    {"path": "B-.S",          "grade": "qicui_buzhang", "basis": "为兄弟之子（侄，齐衰不杖期）"},
    {"path": "B+.D",          "grade": "dagong",        "basis": "为兄弟之女（侄女，大功）"},
    {"path": "B-.D",          "grade": "dagong",        "basis": "为兄弟之女（侄女，大功）"},
    {"path": "B+.S.W",        "grade": "dagong",        "basis": "为侄妇（大功）"},
    {"path": "B-.S.W",        "grade": "dagong",        "basis": "为侄妇（大功）"},
    {"path": "Z+.S",          "grade": "xiaogong",      "basis": "为姊妹之子（外甥，报小功）"},
    {"path": "Z-.S",          "grade": "xiaogong",      "basis": "为姊妹之子（外甥，报小功）"},
    {"path": "Z+.D",          "grade": "xiaogong",      "basis": "为姊妹之女（外甥女）"},
    {"path": "Z-.D",          "grade": "xiaogong",      "basis": "为姊妹之女（外甥女）"},

    {"path": "F.B+",          "grade": "qicui_buzhang", "basis": "为伯叔父母（期亲，齐衰不杖期）"},
    {"path": "F.B+",          "grade": "dagong",        "when": {"ego_gender": "female", "ego_married": true}, "basis": "已嫁女为伯叔父母（大功）"},
    {"path": "F.B-",          "grade": "qicui_buzhang", "basis": "为伯叔父母（期亲，齐衰不杖期）"},
    {"path": "F.B-",          "grade": "dagong",        "when": {"ego_gender": "female", "ego_married": true}, "basis": "已嫁女为伯叔父母（大功）"},
    {"path": "F.B+.W",        "grade": "qicui_buzhang", "basis": "为伯叔母（期亲，齐衰不杖期）"},
    {"path": "F.B-.W",        "grade": "qicui_buzhang", "basis": "为伯叔母（期亲，齐衰不杖期）"},
    {"path": "F.Z+",          "grade": "dagong",        "basis": "为已嫁姑（大功）"},
    {"path": "F.Z+",          "grade": "qicui_buzhang", "when": {"alter_married": false}, "basis": "为在室姑（齐衰不杖期）"},
    {"path": "F.Z-",          "grade": "dagong",        "basis": "为已嫁姑（大功）"},
