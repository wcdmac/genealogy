    {"path": "F.Z.H",         "grade": "sima",          "basis": "为姑父（姻亲尊长，缌麻）"},
    {"path": "M.B+",          "grade": "xiaogong",      "basis": "外亲为舅（小功）"},
    {"path": "M.B-",          "grade": "xiaogong",      "basis": "外亲为舅（小功）"},
    {"path": "M.B+.W",        "grade": "xiaogong",      "basis": "为舅母（从舅服，小功）"},
    {"path": "M.B-.W",        "grade": "xiaogong",      "basis": "为舅母（从舅服，小功）"},
    {"path": "M.Z+",          "grade": "xiaogong",      "basis": "外亲为姨（小功）"},
    {"path": "M.Z-",          "grade": "xiaogong",      "basis": "外亲为姨（小功）"},
    {"path": "M.Z.H",         "grade": "xiaogong",      "basis": "为姨父（从姨服，小功）"},

    {"path": "F.B+.S+",       "grade": "dagong",        "basis": "为堂兄弟（大功）"},
    {"path": "F.B+.S-",       "grade": "dagong",        "basis": "为堂兄弟（大功）"},
    {"path": "F.B-.S+",       "grade": "dagong",        "basis": "为堂兄弟（大功）"},
    {"path": "F.B-.S-",       "grade": "dagong",        "basis": "为堂兄弟（大功）"},
    {"path": "F.B+.D+",       "grade": "dagong",        "basis": "为未嫁堂姐妹（大功）"},
    {"path": "F.B+.D+",       "grade": "xiaogong",      "when": {"alter_married": true}, "basis": "为已嫁堂姐妹（小功）"},
    {"path": "F.B+.D-",       "grade": "dagong",        "basis": "为未嫁堂姐妹（大功）"},
    {"path": "F.B+.D-",       "grade": "xiaogong",      "when": {"alter_married": true}, "basis": "为已嫁堂姐妹（小功）"},
    {"path": "F.B-.D+",       "grade": "dagong",        "basis": "为未嫁堂姐妹（大功）"},
    {"path": "F.B-.D+",       "grade": "xiaogong",      "when": {"alter_married": true}, "basis": "为已嫁堂姐妹（小功）"},
    {"path": "F.B-.D-",       "grade": "dagong",        "basis": "为未嫁堂姐妹（大功）"},
