    {"path": "M.B+.S+",       "grade": "sima",          "basis": "为表兄弟（舅表，缌麻）"},
    {"path": "M.B+.S-",       "grade": "sima",          "basis": "为表兄弟（舅表，缌麻）"},
    {"path": "M.B-.S+",       "grade": "sima",          "basis": "为表兄弟（舅表，缌麻）"},
    {"path": "M.B-.S-",       "grade": "sima",          "basis": "为表兄弟（舅表，缌麻）"},
    {"path": "M.B+.D+",       "grade": "sima",          "basis": "为表姐妹（舅表，缌麻）"},
    {"path": "M.B+.D-",       "grade": "sima",          "basis": "为表姐妹（舅表，缌麻）"},
