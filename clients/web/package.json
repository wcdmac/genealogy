{
  "name": "genealogy-web-client",
  "version": "0.1.0",
  "private": true,
  "description": "genealogy REST 客户端参考实现：openapi-typescript 生成类型 + 薄封装 + Web UI",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit",
