    "dev": "vite",
    "preview": "vite preview",
    "smoke": "node src/api/smoke.ts",
    "ui-smoke": "node scripts/ui-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "openapi-typescript": "^7.4.0",
    "playwright": "^1.64.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
